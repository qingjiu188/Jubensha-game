// =============================================================
// 《副本 / INSTANCE》数据库模型
// 数据库：MySQL 8+ / 9.x（Prisma ORM）
// -------------------------------------------------------------
// 核心设计：账号层 与 角色层 解耦
//   · User（账号）：档案代号 + 接入密钥 + 全局编号 playerNo
//     承载论坛帖子、评论、点赞、收藏、好友关系。
//   · Archive（角色档案）：三维 / 生存值 / 异能 / 线索 / 副本进度。
//     死亡时**只物理删除 Archive**，User 及其社区资产完整保留。
//     重建档案时 playerNo 递增 → 玩家获得新的 No.X 编号。
//
// MySQL 说明：
//   · 原生不支持标量数组，Post.tags 用 Json 存 string[]（API 层转数组）。
//   · 切 PostgreSQL：把 provider 改成 "postgresql" 并把 tags 改成 String[]。
// =============================================================

generator client {
  provider = "prisma-client-js"
  /// 线上宿主是 Linux（Vercel = Amazon Linux / Debian 系），
  /// 本地 macOS 生成客户端时必须把 Linux 查询引擎一并打进去，
  /// 否则部署后会报 "Query engine library for current platform could not be found"。
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/* ---------------- 账号层：死亡不清零 ---------------- */

model User {
  id           String   @id @default(cuid())
  /// 档案代号：仅英文数字，全局唯一
  username     String   @unique
  /// 接入密钥的 bcrypt 哈希
  keyHash      String
  /// 全局自增玩家编号（No.1 / No.2 …），每次重建档案递增
  playerNo     Int      @unique
  /// 当前存活档案 ID（死亡删除后置 null）
  currentArchiveId String?
  /// 第几代档案：0=尚未建档，1=首次，2=死亡后重建…（>1 时递增 playerNo）
  archiveGen   Int      @default(0)

  createdAt DateTime @default(now())

  archive      Archive?  @relation("CurrentArchive")
  posts        Post[]
  comments     Comment[]
  likes        Like[]
  favorites    Favorite[]
  friendships1 Friendship[] @relation("User1")
  friendships2 Friendship[] @relation("User2")
}

/* ---------------- 角色层：死亡即物理删除 ---------------- */

model Archive {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("CurrentArchive", fields: [userId], references: [id], onDelete: Cascade)

  /// 角色代号 = 系统分发的身份（如「灵媒」），与异能一一绑定
  username String
  /// 身份唯一键：全局不允许重复占用；死亡销毁档案后自动释放（MySQL 唯一索引允许多个 NULL）
  identity String? @unique
  /// 身份所属类别（如「通灵与神秘学类」）
  identityCategory String?

  /* ---------- 玩家自定义的角色信息 ---------- */
  /// 角色名字（玩家自己起的，与账号代号、系统身份相互独立）
  displayName String?
  /// 性别：male / female / other / hidden
  gender String?
  /// 样貌自述（纯文本，进副本时注入 AI 上下文）
  appearance String?

  str Int
  int Int
  agi Int

  hp Int @default(100)
  sp Int @default(100)
  st Int @default(100)

  rating       String
  growthPoints Int    @default(0)

  /* ---------- 货币与战利品（角色层，死亡随档案销毁） ---------- */
  /// 积分：商城唯一货币
  credits Int @default(0)
  /// 恢复剂存量：{ "sp": 罐数, "st": 罐数 }
  potions Json?
  /// 武器库：[{ id, name, from, stat, bonus, value }]
  weapons Json?
  /// 当前装备的武器 id
  equippedWeaponId String?
  /// 本局累计击杀数（结算展示）
  kills Int @default(0)

  /* ---------- 随机异能：建档时随机，终身锁定 ---------- */
  abilityName   String
  abilityDesc   String
  abilityRarity String

  status       String @default("alive")
  currentClues Json?

  /* ---------- 当前副本进度（刷新可恢复） ---------- */
  difficulty   String?
  scenarioId   String?
  scenarioName String?
  currentRole  String?
  turn         Int     @default(0)

  updatedAt DateTime @updatedAt
}

/* ---------------- 社区论坛 ---------------- */

model Post {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  content String
  /// 标签数组（MySQL 下以 Json 存储：["求助","剧透警告"]）
  tags    Json?

  /// 转发：指向原帖
  repostOfId String?

  likes     Like[]
  favorites Favorite[]
  comments  Comment[]

  createdAt DateTime @default(now())
}

model Comment {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId  String
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  content String
  /// 楼中楼：父评论 ID
  parentId String?

  createdAt DateTime @default(now())
}

model Like {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Favorite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

/* ---------------- 好友关系 ---------------- */

model Friendship {
  id      String @id @default(cuid())
  user1Id String
  user1   User   @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id String
  user2   User   @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)

  /// pending / accepted
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
}
