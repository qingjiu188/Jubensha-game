# 复制为 .env 后填写（本地开发）
# 不配 DATABASE_URL 也能跑：会自动降级到本地 JSON 文件存储（.data/db.json）

# ---- 数据库 ----
# MySQL 连接串。线上部署（Vercel）必须配置，否则写入会报 SERVERLESS_NO_DATABASE
# 免费云数据库推荐：TiDB Cloud Serverless（MySQL 兼容，无需改代码）
DATABASE_URL="mysql://user:password@127.0.0.1:3306/instance"

# ---- Auth.js v5 ----
# 生成方式：openssl rand -base64 32
AUTH_SECRET="用 openssl rand -base64 32 生成"
# 部署到 Vercel 等代理环境时必须为 true
AUTH_TRUST_HOST=true

# ---- 可选：接入真实 LLM ----
# 不配则走内置脚本 Mock（7 回合固定剧情），游戏流程完全一样
# LLM_API_KEY=""
# LLM_ENDPOINT="https://api.openai.com/v1/chat/completions"
# LLM_MODEL="gpt-4o-mini"
